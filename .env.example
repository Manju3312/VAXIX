# IMMUNIX Sovereign Defense Environment Configuration
# ====================================================

# Sovereign Node Identification
NODE_ENV=production
IMMUNIX_CLUSTER_ID=aws-us-east-1-primary
IMMUNIX_CLUSTER_REGION=us-east-1

# eBPF Socket Interceptor Parameters
IMMUNIX_EBPF_ENABLED=true
IMMUNIX_LATENCY_BUDGET_MS=0.4
IMMUNIX_ZERO_PAYLOAD_RETENTION=true

# Master Sovereign Key (Issued via /api/keys or Sovereign Console)
IMMUNIX_SOVEREIGN_KEY=imx_live_sec_789f2a41bc901a88b

# P2P Gossip Mesh Consensus (Ed25519 Root Key)
IMMUNIX_ED25519_ROOT_KEY=ed25519_pk_78a1bc490f2389dc912a7810b4

# Database Engine
SQLITE_DB_PATH=./data/immunix.sqlite

