# ==============================================================================
# IMMUNIX SOVEREIGN DEFENSE ENVIRONMENT SPECIFICATION
# Autonomous Immune Network for Cloud Software & API Resilience
# Standard: High-Finance Sovereign Cloud (RFC-9457 & NIST SP 800-207 Zero Trust)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NODE IDENTIFICATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=immunix.network
NEXT_PUBLIC_APP_VERSION=2.4.0

# Sovereign Node & Primary Cluster Metadata
IMMUNIX_CLUSTER_ID=aws-us-east-1-primary
IMMUNIX_CLUSTER_NAME="New York Sovereign NY-1"
IMMUNIX_CLUSTER_REGION=us-east-1
IMMUNIX_CLOUD_PROVIDER=AWS
IMMUNIX_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. TIER 1: IN-MEMORY RADIX TRIE / HOT CACHE (Sub-millisecond Edge Wire Defense)
# ------------------------------------------------------------------------------
# Redis 7.2 In-Memory Hot Cache for sub-0.1ms wire antibody rule lookups
REDIS_URL=redis://:imx_redis_wire_hotcache_2026@localhost:6379/0
REDIS_PASSWORD=imx_redis_wire_hotcache_2026
REDIS_TLS_ENABLED=false
WASM_RADIX_TRIE_MAX_DEPTH=64
WASM_RADIX_CACHE_TTL_MS=3600000
IMMUNIX_LATENCY_BUDGET_MS=0.40
IMMUNIX_WIRE_TRANSLATION_MODE=SYNTHETIC_SHIELD

# ------------------------------------------------------------------------------
# 3. TIER 2: COLUMNAR TELEMETRY & ANOMALY STREAM BROKER
# ------------------------------------------------------------------------------
# Apache Kafka / Redpanda High-Throughput Stream Broker
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=immunix-sentry-worker
KAFKA_TOPIC_TELEMETRY=immunix.telemetry.v1
KAFKA_TOPIC_DRIFT_EVENTS=immunix.drift.events.v1

# ClickHouse 24.3 High-Throughput Columnar Anomaly Store (10:1 Compression)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=immunix_telemetry
CLICKHOUSE_USER=immunix
CLICKHOUSE_PASSWORD=imx_clickhouse_secret_2026
CLICKHOUSE_SECURE=false

# ------------------------------------------------------------------------------
# 4. TIER 3: PRIMARY RELATIONAL ACID STORE
# ------------------------------------------------------------------------------
# PostgreSQL 16 (Production Relational ACID Store with pgvector)
DATABASE_URL=postgresql://immunix_admin:imx_dev_secret_vault_password_2026@localhost:5432/immunix_sovereign?sslmode=disable
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=30

# SQLite Embedded Engine (Zero-dependency local runtime fallback)
SQLITE_DB_PATH=./data/immunix.sqlite
SQLITE_WAL_MODE=true

# ------------------------------------------------------------------------------
# 5. TIER 4: SEMANTIC VECTOR MEMORY (Schema Drift Search & Field Matching)
# ------------------------------------------------------------------------------
# pgvector & Qdrant configuration for 1536-dimensional schema embeddings
PGVECTOR_DIMENSIONS=1536
PGVECTOR_DISTANCE_METRIC=cosine
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=imx_qdrant_vec_9814a0f
VECTOR_SIMILARITY_THRESHOLD=0.92

# ------------------------------------------------------------------------------
# 6. TIER 5: DECENTRALIZED BYZANTINE HERD IMMUNITY LEDGER
# ------------------------------------------------------------------------------
# Ed25519 Cryptographic Root Keypair for zero-trust antibody payload signing
IMMUNIX_ED25519_ROOT_KEY=your_ed25519_public_key_here
IMMUNIX_ED25519_PUBLIC_KEY=your_ed25519_public_key_here
IMMUNIX_ED25519_PRIVATE_KEY=your_ed25519_private_key_here

# libp2p GossipSub Protocol & Consensus
P2P_GOSSIPSUB_TOPIC=/immunix/vaccines/1.0.0
P2P_LISTEN_PORT=4001
P2P_BOOTSTRAP_PEERS=/dns4/seed-us-east.immunix.network/tcp/4001/p2p/QmSovereignNode1,/dns4/seed-eu-central.immunix.network/tcp/4001/p2p/QmSovereignNode2
BYZANTINE_CONSENSUS_QUORUM_PERCENT=67
HERD_GLOBAL_PEER_COUNT=14280

# ------------------------------------------------------------------------------
# 7. ZERO-KNOWLEDGE CREDENTIAL VAULT & PRIVACY PRESERVATION
# ------------------------------------------------------------------------------
# Master Sovereign Control Key (Issued via /api/keys or Enterprise SSO)
IMMUNIX_SOVEREIGN_KEY=your_sovereign_master_key_here

# Argon2id Password Hashing Parameters (NIST SP 800-63B Compliant)
ARGON2_MEMORY_COST_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Sovereign Privacy Guarantee: Zero Raw Payload Retention (Metadata and hashes only)
IMMUNIX_ZERO_PAYLOAD_RETENTION=true
PAYLOAD_ENCRYPTION_SECRET=your_payload_encryption_secret_here

# ------------------------------------------------------------------------------
# 8. eBPF KERNEL SOCKET INTERCEPTOR & DATA PLANE
# ------------------------------------------------------------------------------
# eBPF Linux Kernel Socket Interceptor (Ring buffer size, TC filter hook)
IMMUNIX_EBPF_ENABLED=true
IMMUNIX_EBPF_RINGBUF_SIZE_MB=64
IMMUNIX_EBPF_TC_HOOK=ingress_egress
IMMUNIX_EBPF_PIN_PATH=/sys/fs/bpf/immunix

# ------------------------------------------------------------------------------
# 9. AST GENOME ENGINE & EPHEMERAL MICROVM VERIFIER (Speed 2)
# ------------------------------------------------------------------------------
# ts-morph AST worker thread pool
AST_ENGINE_WORKERS=8

# Ephemeral unmocked MicroVM hypervisor for staging contract replay
MICROVM_HYPERVISOR=firecracker
MICROVM_TIMEOUT_MS=5000

# GitHub App Integration for Autonomous Pull Request Synthesis
GITHUB_APP_ID=1092834
GITHUB_APP_INSTALLATION_ID=58291048
GITHUB_APP_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 10. AI AGENT CONTROL PLANE & HEURISTIC INFERENCE
# ------------------------------------------------------------------------------
# Sovereign Model Inference for ambiguous schema mutations
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_FALLBACK_ORDER=anthropic,openai,local-gguf
LLM_TEMPERATURE=0.0
MAX_REPAIR_TOKENS=4096

# ------------------------------------------------------------------------------
# 11. MODEL CONTEXT PROTOCOL (MCP) SERVER ENGINE
# ------------------------------------------------------------------------------
# Built-in RFC MCP JSON-RPC 2.0 interface for Cursor, Claude Desktop & Windsurf
MCP_SERVER_ENABLED=true
MCP_SERVER_PORT=8080
MCP_AUTH_TOKEN=your_mcp_auth_token_here

# ------------------------------------------------------------------------------
# 12. STRIPE FINANCIAL GATEWAY & SOVEREIGN ACCESS BILLING
# ------------------------------------------------------------------------------
# Stripe Secret Key (format: sk_live_... for production, sk_test_... for test)
# When empty or omitted, IMMUNIX automatically activates high-finance Sandbox Clearing.
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Publishable Key for Client-side Elements / Checkout (pk_live_... / pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Webhook Secret for cryptographically verifying charge & subscription events (whsec_...)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Configuration Options
STRIPE_CURRENCY=usd
STRIPE_SIMULATION_MODE=true
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/#pricing
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/#pricing

